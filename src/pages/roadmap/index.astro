---
import Shell from '../../layouts/Shell.astro';
import { labs } from '../../data/content';
---
<Shell title="AI Engineering Labs — Omar Laraqui" description="A transparent roadmap for public, reproducible AI engineering: RAG evaluation, production ML and safe tool-based workflows.">
  <section class="inner-hero"><div class="shell">
    <a class="back-link" href="/">← HOME</a>
    <p class="section-id">IN PUBLIC <span aria-hidden="true">/</span> 2026 ONWARD</p>
    <h1>Evidence over<br /><span class="accent">hype.</span></h1>
    <p class="inner-lead">Three carefully scoped AI engineering projects I plan to publish. A finished lab should include code, test data, evaluation, operational considerations and a demo — not just a notebook.</p>
    <div class="case-meta"><span>ALL THREE LABS: PLANNED</span><span>NO UNVERIFIED RESULTS</span></div>
  </div></section>
  <div class="shell roadmap-list">
    {labs.map((lab) => (
      <article class="roadmap-item">
        <p class="section-id">LAB {lab.number} / {lab.status.toUpperCase()}</p>
        <h2>{lab.title}</h2>
        <p>{lab.focus}</p>
        <p class="proof-line">Evidence to publish: {lab.proof}</p>
      </article>
    ))}
    <div class="roadmap-item">
      <p class="section-id">PUBLICATION STANDARD</p>
      <h2>Show how it works — and how it fails.</h2>
      <p>Each released lab should document its user problem, constraints, architecture, reproducible setup, baseline, measured evaluation, cost and latency where relevant, observed failures, limitations and next steps. If the evidence is missing, the claim stays marked as planned.</p>
      <a class="text-link" style="margin-top:28px" href="/">Back to selected work ↗</a>
    </div>
  </div>
</Shell>
