---
import Shell from '../layouts/Shell.astro';
import { projects, categories, foundations, labs } from '../data/content';
---
<Shell>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="pulse-point" aria-hidden="true"></span> DATA ENGINEERING × APPLIED AI <span class="eyebrow-line"></span> FRANCE</p>
        <h1>Complex data.<br /><span class="soft-line">Useful products<span class="accent">.</span></span></h1>
        <p class="hero-lead">I’m <strong>Omar Laraqui</strong>. I turn challenging data and AI problems into products people can actually use — from architecture and integration to delivery.</p>
        <p class="hero-direction">Senior Data Engineer by foundation. <strong>Building toward Forward Deployed Engineering.</strong></p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href="/experience/">My background <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-facts">
          <div><strong>8<span class="accent">+</span></strong><span>years in data<br />engineering</span></div>
          <div><strong>Azure<span class="accent">/</span>DBX</strong><span>cloud and<br />lakehouse core</span></div>
          <div><strong>01<span class="accent">→</span>04</strong><span>discover, design,<br />validate, deliver</span></div>
        </div>
      </div>
      <div class="hero-visual" role="img" aria-label="Abstract diagram connecting discovery, engineering and product delivery">
        <div class="visual-top"><span>FIELD NOTES / 001</span><span>BUILD SYSTEMS THAT WORK</span></div>
        <div class="visual-orbit orbit-one" aria-hidden="true"></div>
        <div class="visual-orbit orbit-two" aria-hidden="true"></div>
        <div class="visual-core" aria-hidden="true"><span>DATA</span><i>×</i><span>AI</span></div>
        <div class="visual-tag visual-tag-one">01 / DISCOVERY<span>Real user constraints</span></div>
        <div class="visual-tag visual-tag-two">02 / ENGINEERING<span>Reliable integration</span></div>
        <div class="visual-tag visual-tag-three">03 / DELIVERY<span>Usable outcomes</span></div>
        <div class="visual-bottom"><span>PROBLEM</span><span class="visual-progress" aria-hidden="true"><i></i></span><span>PRODUCT</span></div>
      </div>
    </div>
    <div class="hero-edge shell"><span>SCROLL TO EXPLORE</span><span>ENGINEERING OVER HYPE <span class="accent">↘</span></span></div>
  </section>

  <section class="work-section section-space" id="work" aria-labelledby="work-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">01 <span aria-hidden="true">/</span> SELECTED WORK</p><h2 id="work-title">Proof of work<span class="accent">.</span><br /><span class="muted-heading">Not just code.</span></h2></div>
        <p class="section-intro">Six case studies across data platforms, AI products and technical problem-solving. The code behind these projects remains private; the engineering decisions are documented publicly.</p>
      </div>
      <div class="work-controls">
        <div class="filters" role="group" aria-label="Filter by project category">
          {categories.map((category) => (
            <button type="button" class="filter-button" data-filter={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'}>{category.label}</button>
          ))}
        </div>
        <span class="work-count" aria-live="polite"><span data-visible-count>06</span> / 06 PROJECTS</span>
      </div>
      <div class="project-grid" data-project-grid>
        {projects.map((project) => (
          <a class="project-card" href={'/projects/' + project.slug + '/'} data-category={project.category} aria-label={'Read the ' + project.title + ' engineering case study'}>
            <div class={'project-art art-' + project.motif} aria-hidden="true">
              <div class="art-lines"><span></span><span></span><span></span><span></span></div>
              <span class="art-index">/{project.index}</span>
              <span class="art-monogram">{project.title === 'Retail Churn Copilot' ? 'CHURN' : project.title === 'Mission Radar' ? 'RADAR' : project.title === 'BLOOM Terminal' ? 'BLOOM' : project.title === 'PokéValue' ? 'VISION' : project.title === 'SA-OS' ? 'SA/OS' : 'DOSSIER'}</span>
              <span class="art-corner"></span>
            </div>
            <div class="project-details">
              <div class="project-topline"><span>{project.eyebrow}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
              <h3>{project.title}</h3>
              <p>{project.short}</p>
              <div class="stack-tags">{project.stack.slice(0,4).map((tech) => <span>{tech}</span>)}</div>
              <div class="project-bottom"><span><span class="status-dot" aria-hidden="true"></span> CASE STUDY / PRIVATE CODE</span><span>VIEW PROJECT <span aria-hidden="true">↗</span></span></div>
            </div>
          </a>
        ))}
      </div>
      <p class="disclosure">Project summaries are based on repository documentation. “Private source” does not imply verified production adoption or measured customer impact.</p>
    </div>
  </section>

  <section class="approach-section section-space" id="approach" aria-labelledby="approach-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">02 <span aria-hidden="true">/</span> MY APPROACH</p><h2 id="approach-title">From messy brief<br />to working system<span class="accent">.</span></h2></div>
        <p class="section-intro">The bridge between a customer’s problem and a dependable product is engineering judgment — backed by evidence, clear trade-offs and real-world constraints.</p>
      </div>
      <div class="method-grid">
        <article class="method"><span class="method-index">01 / DISCOVER</span><div class="method-symbol">?</div><h3>Find the real problem</h3><p>Users, workflows, success measures, constraints and failure modes before choosing technology.</p></article>
        <article class="method"><span class="method-index">02 / DESIGN</span><div class="method-symbol">◇</div><h3>Choose what fits</h3><p>Architect data, AI and system boundaries with security, simplicity and trade-offs in view.</p></article>
        <article class="method"><span class="method-index">03 / VALIDATE</span><div class="method-symbol">≋</div><h3>Test assumptions</h3><p>Reproducible experiments, realistic data, evaluations and observable behavior.</p></article>
        <article class="method"><span class="method-index">04 / DELIVER</span><div class="method-symbol">↗</div><h3>Make it useful</h3><p>A usable integration or product with safeguards, ownership and a path to improvement.</p></article>
      </div>
    </div>
  </section>

  <section class="labs-section section-space" aria-labelledby="labs-title">
    <div class="shell">
      <div class="labs-hero">
        <div><p class="section-id">03 <span aria-hidden="true">/</span> BUILDING IN PUBLIC</p><h2 id="labs-title">What’s next<br /><em>is measurable.</em></h2></div>
        <div class="labs-hero-aside"><p>Modern AI engineering needs more than a polished demo. These are <strong>planned</strong> public labs that will publish reproducible code, tests, evidence and limitations as they progress.</p><a class="text-link" href="/roadmap/">View the complete roadmap <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="lab-list">
        {labs.map((lab) => (
          <a href="/roadmap/" class="lab-row">
            <span class="lab-n">{lab.number}</span><span class="lab-text"><strong>{lab.title}</strong><span>{lab.focus}</span></span>
            <span class="lab-status">{lab.status}</span><span class="lab-chevron" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="history-section section-space" aria-labelledby="history-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">04 <span aria-hidden="true">/</span> FOUNDATIONS</p><h2 id="history-title">Built over time<span class="accent">.</span></h2></div>
        <p class="section-intro">An earlier chapter in public code. These historical projects demonstrate breadth, not a claim of current production readiness.</p>
      </div>
      <div class="history-grid">
        {foundations.map((project) => (
          <a href={project.url} class="history-item" target="_blank" rel="noopener noreferrer">
            <span class="history-meta">{project.year}</span><h3>{project.title}<span aria-hidden="true">↗</span></h3><p>{project.summary}</p>
          </a>
        ))}
      </div>
      <a class="text-link history-link" href="https://github.com/Omaroid?tab=repositories" target="_blank" rel="noopener noreferrer">Browse public source code <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="shell closing-inner">
      <div><p class="section-id">LET’S BUILD SOMETHING USEFUL</p><h2 id="closing-title">Good engineering starts<br />with the right question<span class="accent">.</span></h2></div>
      <a class="button button-primary" href="https://github.com/Omaroid" target="_blank" rel="noopener noreferrer">Connect on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <script>
    const controls = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLAnchorElement>('[data-project-grid] [data-category]');
    const count = document.querySelector<HTMLElement>('[data-visible-count]');
    for (const control of controls) {
      control.addEventListener('click', () => {
        const category = control.dataset.filter ?? 'all';
        let visible = 0;
        for (const card of cards) {
          const show = category === 'all' || card.dataset.category === category;
          card.hidden = !show;
          if (show) visible++;
        }
        for (const button of controls) button.setAttribute('aria-pressed', String(button === control));
        if (count) count.textContent = String(visible).padStart(2, '0');
      });
    }
  </script>
</Shell>
