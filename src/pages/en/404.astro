---
import Shell from '../../layouts/Shell.astro';
import {otherCopy} from '../../data/i18n';
const t=otherCopy.en;
---
<Shell lang="en" title="Page not found — Omar Laraqui" description="The requested page cannot be found.">
  <section class="inner-hero"><div class="shell">
    <p class="section-id">404 / NOT FOUND</p><h1>{t.notFound}<span class="accent">.</span></h1>
    <a href="/en/" class="button button-primary content-offset-home">{t.goHome} ↗</a>
  </div></section>
</Shell>
