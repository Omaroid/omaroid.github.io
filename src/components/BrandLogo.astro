---
interface Props { name: string; size?: 'normal' | 'small' }
const { name, size = 'normal' } = Astro.props;

// Self-hosted marks keep company identity available without a third-party
// request. The visible company name remains the accessible text label.
const logos: Record<string, string> = {
  'ENGIE': 'engie.png',
  'Groupe Alain Afflelou': 'afflelou.png',
  'iQera': 'iqera.png',
  'AXA': 'axa.png',
  'Natixis': 'natixis.svg',
  'Ingeniance': 'ingeniance.png',
  'Edifixio': 'edifixio.png'
};
const logo = logos[name];
---
{logo && (
  <span class={'client-identity client-identity-' + size}>
    <img
      class="client-identity-logo"
      src={'/logos/clients/' + logo}
      width="44"
      height="44"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="client-identity-name">{name}</span>
  </span>
)}
