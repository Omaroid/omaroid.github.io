---
interface Props { name: string; size?: 'normal' | 'small' }
const { name, size = 'normal' } = Astro.props;
const identities: Record<string, string> = {
  'ENGIE': 'engie',
  'Groupe Alain Afflelou': 'groupe-alain-afflelou',
  'iQera': 'iqera',
  'AXA': 'axa',
  'Natixis': 'natixis',
  'Ingeniance': 'ingeniance',
  'Edifixio': 'edifixio'
};
const identity = identities[name];
---
{identity && (
  <span class={'client-identity client-identity-' + size}>
    <img
      class="client-identity-logo"
      src={'/logos/clients/' + identity + '.svg'}
      width="278"
      height="82"
      alt={name}
      loading="lazy"
      decoding="async"
    />
  </span>
)}
