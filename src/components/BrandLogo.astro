---
interface Props { name: string; size?: 'normal' | 'small' }
const { name, size = 'normal' } = Astro.props;

// Official corporate domains are used as lookup keys by AnyLogo's CDN.
// The CDN may serve an icon, a wordmark or a monogram fallback; our text
// label always remains readable independently of the remote image.
const domains: Record<string, string> = {
  'ENGIE': 'engie.com',
  'Groupe Alain Afflelou': 'afflelou.com',
  'iQera': 'iqera.com',
  'AXA': 'axa.com',
  'Natixis': 'natixis.com',
  'Ingeniance': 'ingeniance.fr',
  'Edifixio': 'edifixio.com'
};
const domain = domains[name];
---
{domain && (
  <span class={'client-identity client-identity-' + size}>
    <img
      class="client-identity-logo"
      src={'https://img.anylogo.dev/' + domain + '?size=128&fallback=monogram'}
      width="44"
      height="44"
      alt=""
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
    <span class="client-identity-name">{name}</span>
  </span>
)}
