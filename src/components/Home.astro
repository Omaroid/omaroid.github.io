---
import Shell from '../layouts/Shell.astro';
import ProjectIcon from './ProjectIcon.astro';
import { getProjects } from '../data/projects.localized';
import { career } from '../data/experience';
import { pathFor, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const work = getProjects(lang);
const summaryRoles = career.filter((role, i) => i === 0 || role.client !== career[i - 1]?.client).slice(0, 5);
const copy = fr ? {
  eyebrow: 'SENIOR DATA ENGINEER & IA APPLIQUÉE', headlineA: 'Des plateformes data', headlineB: 'au service du réel.',
  lead: 'Je modernise les lakehouses gouvernés, les systèmes data de production et les usages IA, de la découverte à la livraison.',
  contact: 'Parlons de votre projet', work: 'Voir mes projets', location: 'Basé en France', years: '8+ ans', yearsSub: 'en ingénierie Data', core: 'Databricks, Spark', coreSub: 'Cloud & DataOps', ai: 'IA appliquée', aiSub: 'De l’idée à la production',
  selected: 'PROJETS SÉLECTIONNÉS', workTitle: 'Des solutions Data et IA, du cadrage à la réalisation.', workIntro: 'Une sélection de produits, d’outils et de systèmes. Chaque étude de cas distingue les capacités documentées des résultats qui restent à mesurer.',
  view: 'Découvrir le projet', career: 'EXPÉRIENCE PROFESSIONNELLE', careerTitle: 'Un parcours construit sur le terrain.', careerIntro: 'Des environnements énergétiques, retail, financiers et assurantiels — avec une progression de l’ingénierie vers l’architecture et le leadership technique.',
  careerLink: 'Voir les missions et responsabilités', about: 'À PROPOS', aboutTitle: 'Le lien entre ingénierie data, IA et valeur métier.', aboutText: 'Je conçois et fais évoluer des plateformes de données fiables et des produits IA utiles. Mon approche associe exigence d’ingénierie, compréhension des utilisateurs et attention portée à la sécurité, à la gouvernance et aux coûts.',
  pillar1: 'Plateformes modernes', pillar1Text: 'Lakehouses gouvernés, pipelines fiables et données prêtes pour l’analytique.', pillar2: 'IA appliquée', pillar2Text: 'Des cas d’usage cadrés, intégrés aux systèmes et évalués avec discernement.', pillar3: 'Responsabilité technique', pillar3Text: 'Des choix expliqués, une qualité suivie et des systèmes maintenables.', pillar4: 'Travail collectif', pillar4Text: 'Une collaboration étroite avec les équipes métier, data et produit.',
  close: 'Faisons de vos données un levier concret.'
} : {
  eyebrow: 'SENIOR DATA ENGINEER & APPLIED AI', headlineA: 'Data platforms', headlineB: 'built for real work.',
  lead: 'I modernize governed lakehouses, production data systems and applied AI use cases, from discovery through delivery.',
  contact: 'Let’s discuss your project', work: 'Explore my work', location: 'Based in France', years: '8+ years', yearsSub: 'in data engineering', core: 'Databricks, Spark', coreSub: 'Cloud & DataOps', ai: 'Applied AI', aiSub: 'From idea to production',
  selected: 'SELECTED WORK', workTitle: 'Practical data and AI solutions, from strategy to delivery.', workIntro: 'A selection of products, tools and systems. Each case study separates documented capabilities from outcomes that still need measurement.',
  view: 'Explore project', career: 'PROFESSIONAL EXPERIENCE', careerTitle: 'A career shaped by hands-on delivery.', careerIntro: 'Across energy, retail, financial services and insurance — progressing from engineering into architecture and technical leadership.',
  careerLink: 'Explore engagements and responsibilities', about: 'ABOUT', aboutTitle: 'Connecting data engineering, AI and business value.', aboutText: 'I design and evolve reliable data platforms and useful AI products. My approach combines strong engineering, user understanding, and careful attention to security, governance and cost.',
  pillar1: 'Modern data platforms', pillar1Text: 'Governed lakehouses, reliable pipelines and analytics-ready data.', pillar2: 'Applied AI', pillar2Text: 'Well-scoped use cases integrated into systems and evaluated with care.', pillar3: 'Technical ownership', pillar3Text: 'Clear decisions, quality practices and maintainable systems.', pillar4: 'Collaborative delivery', pillar4Text: 'Close work with business, data and product teams.',
  close: 'Let’s turn your data into real-world impact.'
};
---
<Shell lang={lang}>
  <section class="portfolio-hero">
    <div class="shell editorial-hero">
      <div class="editorial-copy">
        <p class="editorial-eyebrow"><span></span>{copy.eyebrow}<span></span></p>
        <h1>{copy.headlineA}<br /><em>{copy.headlineB}</em></h1>
        <p class="editorial-lead">{copy.lead}</p>
        <div class="editorial-actions"><a class="button button-primary" href="https://www.linkedin.com/in/omar-laraqui/" target="_blank" rel="noopener noreferrer">{copy.contact} <span aria-hidden="true">→</span></a><a class="button button-ghost" href="#work">{copy.work} <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="brand-illustration" aria-label="Omar Laraqui — Data engineering, applied AI, real impact" role="img">
        <div class="brand-orbit brand-orbit-a"></div><div class="brand-orbit brand-orbit-b"></div>
        <svg class="brand-mark-large" viewBox="0 0 240 180" aria-hidden="true"><path class="mark-o" d="M82 28a62 62 0 1 0 0 124 62 62 0 0 0 0-124Z"/><path class="mark-pulse" d="M28 92h48l19-24 18 48 19-27h37"/><path class="mark-l" d="M166 29v120h53"/></svg>
        <span class="illustration-note note-top">Data engineering<br/>Applied AI<br/>Real impact</span><span class="illustration-note note-bottom">PEOPLE<br/>DATA<br/>SYSTEMS<br/>VALUE</span>
      </div>
      <div class="editorial-facts"><div><span class="fact-symbol">⌖</span><span><strong>{copy.location}</strong><small>{fr ? 'Ouvert aux opportunités' : 'Open to opportunities'}</small></span></div><div><span class="fact-symbol">▱</span><span><strong>{copy.years}</strong><small>{copy.yearsSub}</small></span></div><div><span class="fact-symbol">◉</span><span><strong>{copy.core}</strong><small>{copy.coreSub}</small></span></div><div><span class="fact-symbol">↗</span><span><strong>{copy.ai}</strong><small>{copy.aiSub}</small></span></div></div>
    </div>
  </section>

  <section class="editorial-work" id="work" aria-labelledby="work-title"><div class="shell">
    <div class="editorial-section-heading"><div><p class="editorial-kicker"><span></span>{copy.selected}</p><h2 id="work-title">{copy.workTitle}</h2></div><p>{copy.workIntro}</p></div>
    <div class="editorial-project-grid">
      {work.map((project) => <a class="editorial-project" href={pathFor(lang, '/projects/' + project.slug + '/')} aria-label={(fr ? 'Découvrir ' : 'Explore ') + project.title}>
        <div class="editorial-project-copy"><span class="project-eyebrow">{project.eyebrow}</span><h3>{project.title}</h3><p>{project.short}</p><div class="editorial-tags">{project.stack.slice(0,4).map(tech=><span>{tech}</span>)}</div><span class="editorial-project-link">{copy.view} <b aria-hidden="true">→</b></span></div>
        <div class={'editorial-project-art art-' + project.motif}><ProjectIcon slug={project.slug} /><div class="editorial-art-lines" aria-hidden="true"></div></div>
      </a>)}
    </div>
    <p class="editorial-disclosure">{fr ? 'Les descriptions reflètent la documentation disponible. Les déploiements, performances et résultats métier sont explicitement qualifiés sur chaque étude de cas.' : 'Descriptions reflect available documentation. Deployment, performance and business outcomes are qualified in each case study.'}</p>
  </div></section>

  <section class="editorial-career" id="experience"><div class="shell">
    <div class="editorial-section-heading"><div><p class="editorial-kicker"><span></span>{copy.career}</p><h2>{copy.careerTitle}</h2></div><p>{copy.careerIntro}</p></div>
    <div class="editorial-career-grid">{summaryRoles.map((item) => <a class="editorial-career-card" href={pathFor(lang,'/experience/')}><span class="career-logo">{item.client.slice(0,1)}</span><h3>{item.client}</h3><p>{item.title[lang]}</p><small>{item.dates[lang]}</small></a>)}</div>
    <a class="editorial-text-link" href={pathFor(lang,'/experience/')}>{copy.careerLink} <span aria-hidden="true">→</span></a>
  </div></section>

  <section class="editorial-about" id="about"><div class="shell editorial-about-grid">
    <div><p class="editorial-kicker"><span></span>{copy.about}</p><h2>{copy.aboutTitle}</h2><p class="about-copy">{copy.aboutText}</p><a class="button button-primary" href="https://www.linkedin.com/in/omar-laraqui/" target="_blank" rel="noopener noreferrer">{copy.contact} <span aria-hidden="true">→</span></a></div>
    <div class="editorial-pillars"><article><span>▱</span><h3>{copy.pillar1}</h3><p>{copy.pillar1Text}</p></article><article><span>↗</span><h3>{copy.pillar2}</h3><p>{copy.pillar2Text}</p></article><article><span>⚙</span><h3>{copy.pillar3}</h3><p>{copy.pillar3Text}</p></article><article><span>◎</span><h3>{copy.pillar4}</h3><p>{copy.pillar4Text}</p></article></div>
  </div></section>
  <section class="editorial-cta"><div class="shell editorial-cta-inner"><div><p class="editorial-kicker">{fr ? 'PRÊT À CONSTRUIRE ENSEMBLE ?' : 'READY TO BUILD TOGETHER?'}</p><h2>{copy.close}</h2></div><a class="button" href="https://www.linkedin.com/in/omar-laraqui/" target="_blank" rel="noopener noreferrer">{fr ? 'Me contacter' : 'Get in touch'} <span aria-hidden="true">→</span></a></div></section>
</Shell>
