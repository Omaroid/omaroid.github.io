---
import Shell from '../layouts/Shell.astro';
import TechLogo from './TechLogo.astro';
import BrandLogo from './BrandLogo.astro';
import ProjectIcon from './ProjectIcon.astro';
import { projects, foundations, labs, categories } from '../data/content';
import { getProjects } from '../data/projects.localized';
import { career } from '../data/experience';
import { homeText, categoryLabels, foundationTranslations, labTranslations, pathFor, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeText[lang];
const localizedProjects = getProjects(lang);
const localizedLabs = labs.map((lab, i) => ({ ...lab, ...labTranslations[lang][i] }));
const localizedFoundations = foundations.map((project, i) => ({ ...project, ...foundationTranslations[lang][i] }));
---
<Shell lang={lang}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="pulse-point" aria-hidden="true"></span> {c.eyebrow} <span class="eyebrow-line"></span> FRANCE</p>
        <h1>{c.hero1}<br /><span class="soft-line">{c.hero2}<span class="accent">.</span></span></h1>
        <p class="hero-lead"><strong>Omar Laraqui.</strong> {c.heroLead}</p>
        <p class="hero-direction">{c.heroDirection}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">{c.heroPrimary} <span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href={pathFor(lang,'/experience/')}>{c.heroSecondary} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="brand-strip" aria-label={lang === 'fr' ? 'Clients et expériences' : 'Clients and experience'}>
          <span class="brand-strip-label">{lang === 'fr' ? 'EXPÉRIENCES CLIENTS' : 'CLIENT EXPERIENCE'}</span>
          <div class="brand-strip-list">{['ENGIE', 'Groupe Alain Afflelou', 'iQera', 'AXA', 'Natixis', 'Ingeniance', 'Edifixio'].map(name => <BrandLogo name={name} size="small" />)}</div>
        </div>
        <div class="tech-identity" aria-label={lang === 'fr' ? 'Technologies principales' : 'Core technologies'}>
          {['Databricks','Spark','Python','TypeScript','React'].map(name => <span class="tech-identity-item"><TechLogo name={name} /><span>{name}</span></span>)}
        </div>
        <div class="hero-facts">
          <div><strong>8<span class="accent">+</span></strong><span>{c.factsYears}</span></div>
          <div><strong>Azure<span class="accent">/</span>DBX</strong><span>{c.factsCore}</span></div>
          <div><strong>01<span class="accent">→</span>04</strong><span>{c.factsMethod}</span></div>
        </div>
      </div>
      <div class="hero-visual" role="img" aria-label={c.heroVisual}>
        <div class="visual-top"><span>{c.heroNote}</span><span>{c.heroVisual}</span></div>
        <div class="visual-orbit orbit-one" aria-hidden="true"></div>
        <div class="visual-orbit orbit-two" aria-hidden="true"></div>
        <div class="visual-core" aria-hidden="true"><span>DATA</span><i>×</i><span>AI</span></div>
        <div class="visual-tag visual-tag-one">{lang === 'fr' ? '01 / DÉCOUVERTE' : '01 / DISCOVERY'}<span>{c.tagDiscovery}</span></div>
        <div class="visual-tag visual-tag-two">{lang === 'fr' ? '02 / INGÉNIERIE' : '02 / ENGINEERING'}<span>{c.tagEngineering}</span></div>
        <div class="visual-tag visual-tag-three">{lang === 'fr' ? '03 / LIVRAISON' : '03 / DELIVERY'}<span>{c.tagDelivery}</span></div>
        <div class="visual-bottom"><span>{c.visualProblem}</span><span class="visual-progress" aria-hidden="true"><i></i></span><span>{c.visualProduct}</span></div>
      </div>
    </div>
    <div class="hero-edge shell"><span>{c.scroll}</span><span>{c.mantra} <span class="accent">↘</span></span></div>
  </section>

  <section class="work-section section-space" id="work" aria-labelledby="work-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">{c.workId}</p><h2 id="work-title">{c.workTitle1}<span class="accent">.</span><br /><span class="muted-heading">{c.workTitle2}</span></h2></div>
        <p class="section-intro">{c.workIntro}</p>
      </div>
      <div class="work-controls">
        <div class="filters" role="group" aria-label={lang === 'fr' ? 'Filtrer les projets' : 'Filter projects'}>
          {categories.map((category) => (
            <button type="button" class="filter-button" data-filter={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'}>{categoryLabels[lang][category.id]}</button>
          ))}
        </div>
        <span class="work-count" aria-live="polite"><span data-visible-count>06</span> / 06 {c.count}</span>
      </div>
      <div class="project-grid" data-project-grid>
        {localizedProjects.map((project) => (
          <a class="project-card" href={pathFor(lang,'/projects/' + project.slug + '/')} data-category={project.category} aria-label={(lang === 'fr' ? 'Lire le projet ' : 'Read case study ') + project.title}>
            <div class={'project-art art-' + project.motif} aria-hidden="true">
              <div class="art-lines"><span></span><span></span><span></span><span></span></div>
              <span class="art-index">/{project.index}</span>
              <div class="project-visual-logo" aria-hidden="true">{project.stack.filter(tech => ['Databricks','React','Next.js','PostgreSQL','TypeScript','Vercel','Python','Spark','PySpark','Redis'].includes(tech)).slice(0,3).map(tech => <span class="project-visual-badge"><TechLogo name={tech} /></span>)}</div>
              <ProjectIcon slug={project.slug} />
              <span class="art-corner"></span>
            </div>
            <div class="project-details">
              <div class="project-topline"><span>{project.eyebrow}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
              <h3>{project.title}</h3>
              <p>{project.short}</p>
              <div class="stack-tags">{project.stack.slice(0,4).map((tech) => <span><TechLogo name={tech} />{tech}</span>)}</div>
              <div class="project-bottom"><span><span class="status-dot" aria-hidden="true"></span> {c.private}</span><span>{c.view} <span aria-hidden="true">↗</span></span></div>
            </div>
          </a>
        ))}
      </div>
      <p class="disclosure">{c.disclosure}</p>
    </div>
  </section>

  <section class="approach-section section-space" id="approach" aria-labelledby="approach-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">{c.approachId}</p><h2 id="approach-title">{c.approachTitle1}<br />{c.approachTitle2}<span class="accent">.</span></h2></div>
        <p class="section-intro">{c.approachIntro}</p>
      </div>
      <div class="method-grid">
        <article class="method"><span class="method-index">{lang === 'fr' ? '01 / COMPRENDRE' : '01 / DISCOVER'}</span><div class="method-symbol">?</div><h3>{c.discoverTitle}</h3><p>{c.discoverDesc}</p></article>
        <article class="method"><span class="method-index">{lang === 'fr' ? '02 / CONCEVOIR' : '02 / DESIGN'}</span><div class="method-symbol">◇</div><h3>{c.designTitle}</h3><p>{c.designDesc}</p></article>
        <article class="method"><span class="method-index">{lang === 'fr' ? '03 / VALIDER' : '03 / VALIDATE'}</span><div class="method-symbol">≋</div><h3>{c.validateTitle}</h3><p>{c.validateDesc}</p></article>
        <article class="method"><span class="method-index">{lang === 'fr' ? '04 / LIVRER' : '04 / DELIVER'}</span><div class="method-symbol">↗</div><h3>{c.deliverTitle}</h3><p>{c.deliverDesc}</p></article>
      </div>
    </div>
  </section>

  <section class="experience-preview section-space" aria-labelledby="career-preview-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">{c.careerId}</p><h2 id="career-preview-title">{c.careerTitle1}<span class="accent">.</span><br /><span class="muted-heading">{c.careerTitle2}</span></h2></div>
        <p class="section-intro">{c.careerIntro}</p>
      </div>
      <div class="career-preview-grid">
        {career.slice(0,3).map((role, i) => (
          <a href={pathFor(lang,'/experience/') + '#experience-' + i} class="career-preview-card">
            <span class="history-meta">{role.dates[lang]}</span>
            <div class="preview-client-identity"><BrandLogo name={role.client} size="small" /></div><h3>{role.client} <span aria-hidden="true">↗</span></h3>
            <p>{role.title[lang]}</p>
            <div class="stack-tags">{role.technologies.slice(0,3).map(tech=><span><TechLogo name={tech} />{tech}</span>)}</div>
          </a>
        ))}
      </div>
      <a href={pathFor(lang,'/experience/')} class="text-link history-link">{c.careerView} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="labs-section section-space" aria-labelledby="labs-title">
    <div class="shell">
      <div class="labs-hero">
        <div><p class="section-id">{c.labsId}</p><h2 id="labs-title">{c.labsTitle1}<br /><em>{c.labsTitle2}.</em></h2></div>
        <div class="labs-hero-aside"><p>{c.labsIntro}</p><a class="text-link" href={pathFor(lang,'/roadmap/')}>{c.labsView} <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="lab-list">
        {localizedLabs.map((lab) => (
          <a href={pathFor(lang,'/roadmap/')} class="lab-row">
            <span class="lab-n">{lab.number}</span><span class="lab-text"><strong>{lab.title}</strong><span>{lab.focus}</span></span>
            <span class="lab-status">{c.planned}</span><span class="lab-chevron" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="history-section section-space" aria-labelledby="history-title">
    <div class="shell">
      <div class="section-header">
        <div><p class="section-id">{c.historyId}</p><h2 id="history-title">{c.historyTitle}<span class="accent">.</span></h2></div>
        <p class="section-intro">{c.historyIntro}</p>
      </div>
      <div class="history-grid">
        {localizedFoundations.map((project) => (
          <a href={project.url} class="history-item" target="_blank" rel="noopener noreferrer">
            <span class="history-meta">{lang === 'fr' ? project.year.replace('Historical','Historique') : project.year}</span><h3>{project.title}<span aria-hidden="true">↗</span></h3><p>{project.summary}</p>
          </a>
        ))}
      </div>
      <a class="text-link history-link" href="https://github.com/Omaroid?tab=repositories" target="_blank" rel="noopener noreferrer">{c.historyLink} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="shell closing-inner">
      <div><p class="section-id">{c.closeId}</p><h2 id="closing-title">{c.closeTitle}<span class="accent">.</span></h2></div>
      <a class="button button-primary" href="https://github.com/Omaroid" target="_blank" rel="noopener noreferrer">{c.closeLink} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <script>
    const controls = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLAnchorElement>('[data-project-grid] [data-category]');
    const count = document.querySelector<HTMLElement>('[data-visible-count]');
    for (const control of controls) {
      control.addEventListener('click', () => {
        const category = control.dataset.filter ?? 'all';
        let visible = 0;
        for (const card of cards) {
          const show = category === 'all' || card.dataset.category === category;
          card.hidden = !show;
          if (show) visible++;
        }
        for (const button of controls) button.setAttribute('aria-pressed', String(button === control));
        if (count) count.textContent = String(visible).padStart(2, '0');
      });
    }
  </script>
</Shell>
