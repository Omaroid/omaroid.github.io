---
import Shell from '../layouts/Shell.astro';
import TechLogo from './TechLogo.astro';
import ProjectIcon from './ProjectIcon.astro';
import { otherCopy, pathFor, type Lang } from '../data/i18n';
import { getProject } from '../data/projects.localized';

interface Props { lang:Lang; slug:string }
const { lang, slug } = Astro.props;
const project = getProject(lang,slug);
if (!project) throw new Error('Unknown case study: ' + slug);
const t = otherCopy[lang];
const isPublic = project.repositoryVisibility === 'public' && !!project.repositoryUrl;
const repositoryHref = isPublic ? project.repositoryUrl! : `mailto:omarlaraqui59@gmail.com?subject=${encodeURIComponent((lang === 'fr' ? 'Demande d’accès au dépôt : ' : 'Repository access request: ') + project.title)}&body=${encodeURIComponent((lang === 'fr' ? 'Bonjour Omar,\n\nJe souhaiterais en savoir plus sur le dépôt ' : 'Hi Omar,\n\nI would like to learn more about the repository ') + project.title + '.\n')}`;
---
<Shell lang={lang} title={project.title + ' — ' + (lang === 'fr' ? 'Étude de cas | Omar Laraqui' : 'Engineering case study | Omar Laraqui')} description={project.short} pageType="article">
  <section class="inner-hero">
    <div class="shell">
      <a class="back-link" href={pathFor(lang,'/')+'#work'}>← {t.back}</a>
      <p class="section-id">{project.index} <span aria-hidden="true">/</span> {project.eyebrow.toUpperCase()}</p>
      <div class="case-project-heading"><ProjectIcon slug={project.slug} variant="detail" /><h1>{project.title}<span class="accent">.</span></h1></div>
      <p class="inner-lead">{project.short}</p>
      {project.context && <p class="case-context">{project.context}</p>}
      <div class="case-meta"><span>{project.status}</span><span>{t.case}</span><span>{t.sensitive}</span></div>
      <div class="case-actions">
        <a class="button button-primary" href={repositoryHref} target={isPublic ? '_blank' : undefined} rel={isPublic ? 'noopener noreferrer' : undefined}>{isPublic ? (lang === 'fr' ? 'Voir le dépôt public' : 'View public repository') : (lang === 'fr' ? 'Demander l’accès au dépôt' : 'Request repository access')} <span aria-hidden="true">{isPublic ? '↗' : '→'}</span></a>
        {project.demoUrl && <a class="button button-ghost" href={project.demoUrl} target="_blank" rel="noopener noreferrer">{lang === 'fr' ? 'Ouvrir la démo publique' : 'Open public demo'} ↗</a>}
      </div>
    </div>
  </section>
  <div class="shell case-content">
    <article class="case-story">
      <section>
        <p class="section-id">{t.problemId}</p>
        <h2>{t.problemTitle}</h2>
        <p>{project.problem}</p>
      </section>
      <section>
        <p class="section-id">{t.approachId}</p>
        <h2>{t.approachTitle}</h2>
        <ul>{project.approach.map(item=><li>{item}</li>)}</ul>
      </section>
      <section>
        <p class="section-id">{t.decisionId}</p>
        <h2>{t.decisionTitle}</h2>
        <p class="quote-decision">{project.decision}</p>
      </section>
      <section>
        <p class="section-id">{t.evidenceId}</p>
        <h2>{t.evidenceTitle}</h2>
        <p class="evidence-note">{project.evidence}</p>
      </section>
      <section>
        <p class="section-id">{t.nextId}</p>
        <h2>{t.nextTitle}</h2>
        <ul>{project.next.map(item=><li>{item}</li>)}</ul>
        <p class="content-offset-sm">{t.nextNote}</p>
      </section>
      <a class="text-link content-offset-lg" href={pathFor(lang,'/')+'#work'}>{t.projectView} ↗</a>
    </article>
    <aside class="case-sidebar" aria-label={t.sidebar}>
      <h2>{t.sidebar}</h2>
      <dl>
        <div><dt>{lang === 'fr' ? 'Projet' : 'Project'}</dt><dd>{project.title}</dd></div>
        <div><dt>{t.area}</dt><dd>{project.categoryName}</dd></div>
        <div><dt>{t.visibility}</dt><dd>{isPublic ? (lang === 'fr' ? 'Code source public sur GitHub' : 'Public source on GitHub') : (lang === 'fr' ? 'Code privé · accès sur demande' : 'Private source · access by request')}</dd></div>
        <div><dt>{t.validation}</dt><dd>{t.validationValue}</dd></div>
      </dl>
      <div class="case-stack">{project.stack.map(tech=><span><TechLogo name={tech} />{tech}</span>)}</div>
    </aside>
  </div>
</Shell>
