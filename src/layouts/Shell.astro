---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { nav, opposite, pathFor, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  pageType?: 'website' | 'article';
  lang?: Lang;
}

const {
  lang = 'fr',
  title = lang === 'fr'
    ? 'Omar Laraqui — Tech Lead Data & IA | Projets et expériences'
    : 'Omar Laraqui — Data & AI Tech Lead | Projects and experience',
  description = lang === 'fr'
    ? 'Tech Lead Data & IA, expériences clients et projets Data, Cloud et IA. Un parcours en évolution vers le Forward Deployed Engineering.'
    : 'Data & AI Tech Lead showcasing client experience and Data, Cloud and AI projects. Building toward Forward Deployed Engineering.',
  pageType = 'website'
} = Astro.props;

const t = nav[lang];
const rawPath = Astro.url.pathname;
const isNotFound = rawPath.endsWith('/404.html') || rawPath.endsWith('/404/');
const currentPath = rawPath.replace(/\/+$/, '') + '/';
// A 404 is intentionally a special route on GitHub Pages (404.html, not /404/).
// Language links from a missing page lead safely to the other locale's homepage.
const routePath = isNotFound ? '/' : (lang === 'en'
  ? currentPath.replace(/^\/en(?=\/)/, '') || '/'
  : currentPath);
const frUrl = new URL(pathFor('fr', routePath), Astro.site ?? 'https://omaroid.github.io').toString();
const enUrl = new URL(pathFor('en', routePath), Astro.site ?? 'https://omaroid.github.io').toString();
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://omaroid.github.io').toString();
const switchTo = pathFor(opposite(lang), routePath);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Omar Laraqui',
  url: 'https://omaroid.github.io/',
  sameAs: ['https://github.com/Omaroid'],
  jobTitle: 'Data & AI Tech Lead',
  knowsAbout: ['Databricks', 'Azure', 'Apache Spark', 'Data Engineering', 'AI Engineering', 'Data Architecture']
};
const structuredData = JSON.stringify(schema);
const structuredDataHash = createHash('sha256').update(structuredData).digest('base64');
// GitHub Pages cannot set custom response headers. This meta policy provides
// browser-side defense in depth for the static-only portfolio. It cannot
// replace HTTP-only directives such as frame-ancestors or HSTS.
const csp = [
  "default-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
  "frame-src 'none'",
  "object-src 'none'",
  "connect-src 'none'",
  "img-src 'self' data:",
  "font-src 'self'",
  "style-src 'self'",
  "script-src 'self' 'sha256-" + structuredDataHash + "'",
  "manifest-src 'self'",
  "upgrade-insecure-requests"
].join('; ');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f5" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="description" content={description} />
    <meta name="author" content="Omar Laraqui" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:site_name" content="Omar Laraqui" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-frame premium-surface">
      <header class="site-header">
        <div class="shell nav-row">
          <a class="wordmark" href={pathFor(lang,'/')} aria-label={'Omar Laraqui — ' + t.logo}>
            <span class="wordmark-glyph" aria-hidden="true">O<span>∕</span>L</span>
            <span class="wordmark-name">OMAR LARAQUI</span>
          </a>
          <nav class="desktop-nav" aria-label="Main navigation">
            <a href={pathFor(lang,'/') + '#work'}>{t.work}</a>
            <a href={pathFor(lang,'/') + '#approach'}>{t.approach}</a>
            <a href={pathFor(lang,'/experience/')}>{t.experience}</a>
            <a href={pathFor(lang,'/roadmap/')}>{t.labs}</a>
          </nav>
          <div class="nav-right">
            <div class="language-toggle" aria-label="Language / Langue">
              <a href={lang === 'fr' ? canonical : switchTo} lang="fr" hreflang="fr" aria-current={lang === 'fr' ? 'page' : undefined} title="Français">FR</a>
              <span aria-hidden="true">/</span>
              <a href={lang === 'en' ? canonical : switchTo} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined} title="English">EN</a>
            </div>
            <a class="nav-github" href="https://github.com/Omaroid" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <details class="mobile-nav">
              <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
              <nav aria-label="Mobile navigation">
                <a href={pathFor(lang,'/') + '#work'}>{t.work}</a>
                <a href={pathFor(lang,'/') + '#approach'}>{t.approach}</a>
                <a href={pathFor(lang,'/experience/')}>{t.experience}</a>
                <a href={pathFor(lang,'/roadmap/')}>{t.labs}</a>
                <a href="https://github.com/Omaroid">GitHub ↗</a>
              </nav>
            </details>
          </div>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div class="shell footer-inner">
          <div>
            <a class="footer-brand" href={pathFor(lang,'/')}>Omar Laraqui<span class="accent">.</span></a>
            <p>{lang === 'fr' ? 'Tech Lead Data & IA — vers le Forward Deployed Engineering.' : 'Data & AI Tech Lead — building toward Forward Deployed Engineering.'}</p>
          </div>
          <div class="footer-links" aria-label="Footer links">
            <a href={pathFor(lang,'/') + '#work'}>{t.work}</a>
            <a href={pathFor(lang,'/experience/')}>{t.experience}</a>
            <a href={pathFor(lang,'/roadmap/')}>{t.labs}</a>
            <a href="https://github.com/Omaroid" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
          <p class="footnote">© {new Date().getFullYear()} Omar Laraqui. {lang === 'fr' ? 'Site original et statique.' : 'Original static portfolio.'}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
